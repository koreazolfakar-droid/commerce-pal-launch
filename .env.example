# Server-only secrets. Never prefix these with VITE_.
SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API — server only. Required by the separate live dashboard API.
# Recommended for a Dev Dashboard app that acts on your own store:
# the server exchanges these credentials for a short-lived access token and refreshes it automatically.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-07

# Optional legacy/existing custom-app fallback. If set, this token takes precedence over client credentials.
SHOPIFY_ADMIN_API_TOKEN=

# Separate dashboard security. Never expose this key through VITE_* variables.
# Production example: https://admin.spacecallapp.store
ADMIN_DASHBOARD_ORIGIN=http://localhost:5174
ADMIN_DASHBOARD_API_KEY=

# Public storefront configuration (safe to expose to the browser bundle).
VITE_STORE_NAME=Space Call
VITE_SITE_URL=https://spacecallapp.store
VITE_SHOPIFY_STORE_DOMAIN=dj6qeq-j9.myshopify.com
VITE_SHOPIFY_API_VERSION=2026-07
VITE_WHATSAPP_NUMBER=96181813805

# Public business details printed on downloadable order invoices.
# Fill these with your real legal/contact details before production if available.
VITE_INVOICE_LEGAL_NAME=Space Call
VITE_INVOICE_ADDRESS=Lebanon
VITE_INVOICE_PHONE=+961 81 813 805
VITE_INVOICE_EMAIL=

# Whish Money checkout details shown publicly to customers when they select Whish Money.
VITE_WHISH_MONEY_ACCOUNT=+961 81813805
VITE_WHISH_MONEY_ACCOUNT_NAME=

# Optional social profiles. Empty values hide the corresponding footer icons.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# Supabase public CMS integration.
SUPABASE_URL=https://rtwyankpxtffqqrasyzw.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
