# Space Call standalone staging configuration.
# This branch intentionally has no Shopify credentials or Shopify runtime dependency.

# Public storefront configuration (safe to expose to the browser bundle).
VITE_STORE_NAME=Space Call
VITE_SITE_URL=http://localhost:3000
VITE_WHATSAPP_NUMBER=96181813805

# Optional standalone Dashboard URL used by the staging /dashboard route.
# Keep this pointed at the isolated fast-site-lift deployment until the shared data layer is connected.
VITE_DASHBOARD_URL=https://fast-site-lift.vercel.app

# Public business details printed on downloadable order invoices.
VITE_INVOICE_LEGAL_NAME=Space Call
VITE_INVOICE_ADDRESS=Lebanon
VITE_INVOICE_PHONE=+961 81 813 805
VITE_INVOICE_EMAIL=

# Whish Money checkout details shown publicly to customers when they select Whish Money.
VITE_WHISH_MONEY_ACCOUNT=+961 81813805
VITE_WHISH_MONEY_ACCOUNT_NAME=

# Optional social profiles. Empty values hide the corresponding footer icons.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# Space Call native data layer.
# Use "auto" while staging is empty; switch to "supabase" once migration is complete.
VITE_STOREFRONT_DATA_SOURCE=auto
VITE_SUPABASE_URL=https://rtwyankpxtffqqrasyzw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
