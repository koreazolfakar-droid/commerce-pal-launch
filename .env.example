# Public storefront configuration (safe to expose to the browser bundle).
VITE_STORE_NAME=Space Call
VITE_SITE_URL=https://spacecallapp.store
VITE_WHATSAPP_NUMBER=96181813805

# Public business details printed on downloadable order invoices.
# Fill these with your real legal/contact details before production if available.
VITE_INVOICE_LEGAL_NAME=Space Call
VITE_INVOICE_ADDRESS=Lebanon
VITE_INVOICE_PHONE=+961 81 813 805
VITE_INVOICE_EMAIL=

# Whish Money checkout details shown publicly to customers when they select Whish Money.
VITE_WHISH_MONEY_ACCOUNT=+961 81813805
VITE_WHISH_MONEY_ACCOUNT_NAME=

# Optional social profiles. Empty values hide the corresponding footer icons.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# Supabase public CMS integration.
SUPABASE_URL=https://rtwyankpxtffqqrasyzw.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=


# Auth0 dashboard security layer.
# Create a Single Page Application in Auth0 and configure:
# Allowed Callback URL: https://spacecallapp.store/dashboard
# Allowed Logout URL: https://spacecallapp.store
# Allowed Web Origin: https://spacecallapp.store
# These are public SPA identifiers; never add an Auth0 Client Secret to VITE_* variables.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=


# Cloudflare Turnstile for dashboard Auth.
# VITE_TURNSTILE_SITE_KEY is PUBLIC and safe in the browser bundle.
# Keep the Turnstile Secret Key OUT of this repository and VITE_* variables.
# Configure the Secret Key in Supabase Dashboard:
# Authentication -> Bot and Abuse Protection -> CAPTCHA -> Cloudflare Turnstile.
VITE_TURNSTILE_SITE_KEY=



# Gemini AI for the Dashboard Copilot.
# GEMINI_API_KEY is SERVER-ONLY. Configure the production value as a Supabase
# Edge Function secret. Never expose it through a VITE_* environment variable.
GEMINI_API_KEY=
# Optional override. The dashboard AI function defaults to the current Gemini Flash model with free-tier token support.
GEMINI_MODEL=gemini-3.8-flash

# Customer delivery map. Restrict this browser key to the production domains
# and enable Maps JavaScript API + Geocoding API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
