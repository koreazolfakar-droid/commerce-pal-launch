# Server-only secrets. Never prefix these with VITE_.
SHOPIFY_STOREFRONT_TOKEN=

# Optional Shopify webhook signature secret. Configure product/update,
# product/delete, inventory_levels/update and collection/update webhooks to the
# storefront cache invalidation endpoint when enabling webhook invalidation.
SHOPIFY_WEBHOOK_SECRET=

# Public storefront configuration (safe to expose to the browser bundle).
VITE_STORE_NAME=Space Call
VITE_SITE_URL=https://spacecallapp.store
VITE_SHOPIFY_STORE_DOMAIN=dj6qeq-j9.myshopify.com
VITE_SHOPIFY_API_VERSION=2026-07
VITE_WHATSAPP_NUMBER=96181813805

# Optional Google measurement / ownership configuration.
# When VITE_GA4_MEASUREMENT_ID is empty, commerce events are still pushed to
# window.dataLayer so a consent-aware GTM setup can consume them.
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# Whish Money checkout details shown publicly to customers when they select Whish Money.
VITE_WHISH_MONEY_ACCOUNT=+961 81813805
VITE_WHISH_MONEY_ACCOUNT_NAME=

# Optional social profiles. Empty values hide the corresponding footer icons.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: enables automatic official manufacturer research on product pages.
# OPENAI_API_KEY is already used by legacy product enrichment.

# Gemini shopping advisor + Google Search grounding.
# Keep these server-only. GOOGLE_API_KEY is also accepted and takes precedence.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
