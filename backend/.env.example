# Never commit a real database password or secret.
# Copy the exact connection string from Supabase Dashboard -> Connect.
# Persistent IPv6 backend: Direct connection.
# IPv4-only persistent backend: Session pooler.
# Keep TLS enabled. Prefer sslmode=verify-full when the Supabase CA is configured.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

BIND_ADDR=0.0.0.0:8080
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
RUST_LOG=space_call_backend=info,tower_http=info

# Public project values only. Never put service_role or sb_secret keys here.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
