# Use a server-only Supabase Postgres connection string.
# Prefer the Supabase session pooler URL and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_NAME=postgres

# Owner login for the AdminJS panel.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Generate a long random secret (32+ characters). Never reuse your admin password.
ADMIN_COOKIE_SECRET=

PORT=3001
