# Browser cache policy for Cloudflare Workers static assets.
# HTML remains controlled by the SSR worker and its explicit no-store policy.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand-logos/*
  Cache-Control: public, max-age=604800

/category-icons/*
  Cache-Control: public, max-age=604800

/logo.svg
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=604800
